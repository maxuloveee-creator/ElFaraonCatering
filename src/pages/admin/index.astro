---
import "../../admin/styles.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readMenuPublicationBuildMetadata } from "../../utils/menuPublicationBuild.mjs";
import { loadSupabaseMenuPublicationContentHash } from "../../utils/menuSupabaseContent";

const deployedContentHash = await loadSupabaseMenuPublicationContentHash();
const publicationMetadata = import.meta.env.DEV
  ? null
  : readMenuPublicationBuildMetadata();
---

<BaseLayout
  title="Admin operativo | El Faraón Catering"
  description="Panel operativo para preparar menú del día, parrilla, disponibilidad, precios y publicación."
>
  <main
    class="admin-root"
    data-admin-root
    data-deployed-content-hash={deployedContentHash}
    data-publication-request-id={publicationMetadata?.requestId ?? ""}
    data-publication-revision-id={publicationMetadata?.revisionId ?? ""}
    data-publication-content-hash={deployedContentHash}
    data-vercel-deployment-id={publicationMetadata?.deploymentId ?? ""}
  >
    <section class="admin-loading" aria-live="polite" aria-busy="true">
      <div class="admin-loading__panel">
        <div class="admin-loading__indicator" aria-hidden="true"></div>
        <div class="admin-loading__content">
          <p class="admin-kicker">Panel operativo</p>
          <h1 class="admin-title">Cargando panel operativo</h1>
          <p class="admin-muted">Estamos verificando tu sesión y permisos.</p>
          <p class="admin-loading__help">Si tarda más de unos segundos, recargá la página o volvé a iniciar sesión.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import "../../admin/main";
  </script>
</BaseLayout>
