# Keep this HTTPS origin aligned with `connect-src` in vercel.json.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_AUDIT_DB_URL=

# Optional local OpenSSL executable override for `npm run supabase:tls:verify`.
# OPENSSL_PATH=

# Optional local-only Supabase Management API token for CLI audits such as
# `npm run supabase -- secrets list`. Do not expose it as PUBLIC_* and do not
# set it in frontend hosting envs.
# SUPABASE_ACCESS_TOKEN=

# Supabase Edge Function secrets for publish-menu-changes.
# Set real values with `supabase secrets set`; do not expose them as PUBLIC_*.
VERCEL_DEPLOY_HOOK_URL=
PUBLISH_ALLOWED_ORIGINS=https://elfaraoncatering.com.ar
PUBLISH_STALE_SECONDS=900
PUBLISH_CANONICAL_ADMIN_URL=https://elfaraoncatering.com.ar/admin/
VERCEL_PROJECT_ID=
# Optional Account Webhook acceleration and protected-deployment access.
# VERCEL_WEBHOOK_SECRET=
# VERCEL_TEAM_ID=
# VERCEL_DEPLOYMENT_BYPASS_SECRET=
